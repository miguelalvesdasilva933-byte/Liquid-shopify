{%- comment -%}
  ============================================================
  COMPARISON TABLE — tabela comparativa marca vs concorrentes
  ============================================================
  Layout split: texto com bullet points à esquerda,
  tabela de comparação à direita com checkmarks/X.
  Estilo Foamr — "What makes Solevia so different?"
{%- endcomment -%}
<div class="comparison" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="comparison__grid">
      {%- comment -%} Left: heading + bullets {%- endcomment -%}
      <div class="comparison__info">
        {%- if section.settings.heading != blank -%}
          <div class="comparison__heading">{{ section.settings.heading }}</div>
        {%- endif -%}

        <ul class="comparison__bullets">
          {%- for block in section.blocks -%}
            {%- if block.type == 'bullet' -%}
              <li class="comparison__bullet-item" {{ block.shopify_attributes }}>
                <svg class="comparison__bullet-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent, #e85d04)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} Right: comparison table {%- endcomment -%}
      <div class="comparison__table-wrap">
        <table class="comparison__table">
          <thead>
            <tr>
              <th class="comparison__th-feature"></th>
              <th class="comparison__th-brand">{{ section.settings.brand_name | default: 'Solevia' | escape }}</th>
              <th class="comparison__th-others">{{ section.settings.others_label | default: 'Regular insoles' | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'row' -%}
                <tr {{ block.shopify_attributes }}>
                  <td class="comparison__feature">{{ block.settings.feature | escape }}</td>
                  <td class="comparison__cell comparison__cell--brand">
                    {%- if block.settings.brand_has -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {%- else -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    {%- endif -%}
                  </td>
                  <td class="comparison__cell comparison__cell--others">
                    {%- if block.settings.others_has -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {%- else -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    {%- endif -%}
                  </td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<style>
  .comparison {
    padding: 64px 0;
    background-color: var(--color-background, #fff);
  }
  .comparison__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .comparison__heading {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    line-height: 1.2;
    margin: 0 0 28px;
  }
  .comparison__heading p { margin: 0; }
  .comparison__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .comparison__bullet-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--f2);
    line-height: 1.4;
  }
  .comparison__bullet-icon { flex-shrink: 0; }
  .comparison__table-wrap {
    overflow-x: auto;
  }
  .comparison__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--f1);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }
  .comparison__table thead th {
    padding: 14px 16px;
    text-align: center;
    font-size: var(--f1);
    font-weight: 600;
  }
  .comparison__th-feature { background: transparent; }
  .comparison__th-brand {
    background-color: var(--color-accent, #e85d04);
    color: #fff;
    border-radius: 12px 12px 0 0;
    min-width: 110px;
  }
  .comparison__th-others {
    background-color: var(--color-background-contrast, #f5f5f5);
    color: var(--color-text);
    min-width: 110px;
  }
  .comparison__feature {
    padding: 12px 16px;
    font-weight: 500;
    border-bottom: 1px solid var(--color-border, #e5e5e5);
    font-size: var(--f1);
  }
  .comparison__cell {
    padding: 12px 16px;
    text-align: center;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .comparison__cell--brand {
    background-color: var(--color-accent, #e85d04);
  }
  .comparison__cell--others {
    background-color: var(--color-background-contrast, #f5f5f5);
  }
  .comparison__table tr:last-child .comparison__feature,
  .comparison__table tr:last-child .comparison__cell { border-bottom: none; }

  @media screen and (max-width: 749px) {
    .comparison__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Comparison Table",
  "tag": "section",
  "settings": [
    { "type": "richtext", "id": "heading", "default": "<p>What makes <strong>Solevia</strong> so different?</p>", "label": "Heading" },
    { "type": "text", "id": "brand_name", "default": "Solevia", "label": "Brand column label" },
    { "type": "text", "id": "others_label", "default": "Regular insoles", "label": "Others column label" }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet point",
      "settings": [
        { "type": "text", "id": "text", "default": "Subtle massage with every step", "label": "Text" }
      ]
    },
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "feature", "default": "Cloud-like comfort", "label": "Feature name" },
        { "type": "checkbox", "id": "brand_has", "default": true, "label": "Brand has this?" },
        { "type": "checkbox", "id": "others_has", "default": false, "label": "Others have this?" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        { "type": "bullet", "settings": { "text": "Subtle massage with every step" } },
        { "type": "bullet", "settings": { "text": "Relieves pressure points & fatigue" } },
        { "type": "bullet", "settings": { "text": "Fits & molds to any shoe" } },
        { "type": "row", "settings": { "feature": "Cloud-like comfort", "brand_has": true, "others_has": false } },
        { "type": "row", "settings": { "feature": "Massaging foam layer that relieves pressure", "brand_has": true, "others_has": false } },
        { "type": "row", "settings": { "feature": "Support for prolonged standing & walking", "brand_has": true, "others_has": false } },
        { "type": "row", "settings": { "feature": "Universal fit", "brand_has": true, "others_has": false } },
        { "type": "row", "settings": { "feature": "Odor-free & antibacterial", "brand_has": true, "others_has": false } },
        { "type": "row", "settings": { "feature": "Affordable price", "brand_has": true, "others_has": true } }
      ]
    }
  ]
}
{% endschema %}