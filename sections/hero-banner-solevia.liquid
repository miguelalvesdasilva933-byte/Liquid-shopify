{%- comment -%}
  ============================================================
  HERO BANNER SOLEVIA — banner principal estilo landing page
  ============================================================
  Banner hero com imagem de fundo, headline grande, subtitulo,
  botao CTA, avaliacao com estrelas e contagem de reviews.
  Inspirado no estilo Foamr — fundo com imagem, texto à esquerda.
{%- endcomment -%}
<div class="hero-solevia" data-section-id="{{ section.id }}">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 3000
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'hero-solevia__bg',
        widths: '600, 900, 1200, 1600, 2000, 3000',
        sizes: '100vw',
        alt: section.settings.image.alt | default: section.settings.heading | escape
    }}
  {%- else -%}
    <div class="hero-solevia__bg hero-solevia__placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  <div class="hero-solevia__overlay"></div>

  <div class="hero-solevia__content page-width">
    <div class="hero-solevia__text-box">
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-solevia__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero-solevia__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="hero-solevia__cta">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}

      {%- if section.settings.show_rating -%}
        <div class="hero-solevia__rating">
          <div class="hero-solevia__stars" aria-label="Rated {{ section.settings.rating_score }} stars">
            {%- for i in (1..5) -%}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {%- endfor -%}
          </div>
          <span class="hero-solevia__rating-text">
            {{ section.settings.rating_score }}/5 — {{ section.settings.rating_count }}
          </span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .hero-solevia {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 520px;
    overflow: hidden;
  }
  .hero-solevia__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-solevia__placeholder {
    background: var(--color-background-contrast);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-solevia__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.15) 60%, transparent 100%);
    z-index: 1;
  }
  .hero-solevia__content {
    position: relative;
    z-index: 2;
    padding-top: 60px;
    padding-bottom: 60px;
  }
  .hero-solevia__text-box {
    max-width: 600px;
  }
  .hero-solevia__heading {
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: #fff;
    margin: 0 0 12px;
    line-height: 1.1;
    text-shadow: 0 2px 16px rgba(0,0,0,0.3);
  }
  .hero-solevia__subheading {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: rgba(255,255,255,0.9);
    margin: 0 0 28px;
    line-height: 1.5;
    text-shadow: 0 1px 8px rgba(0,0,0,0.25);
  }
  .hero-solevia__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 14px 32px;
    font-family: var(--font-heading-family);
    font-size: var(--f2);
    font-weight: 600;
    color: #fff;
    background-color: var(--color-accent, #e85d04);
    border: 2px solid var(--color-accent, #e85d04);
    border-radius: var(--buttons-radius, 6px);
    text-decoration: none;
    transition: background-color 0.2s, transform 0.15s;
    cursor: pointer;
  }
  .hero-solevia__cta:hover {
    background-color: color-mix(in srgb, var(--color-accent, #e85d04) 85%, #000);
    transform: translateY(-1px);
  }
  .hero-solevia__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
  }
  .hero-solevia__stars {
    display: flex;
    gap: 2px;
  }
  .hero-solevia__rating-text {
    font-size: var(--f1);
    color: rgba(255,255,255,0.85);
  }
  @media screen and (max-width: 749px) {
    .hero-solevia {
      min-height: 420px;
    }
    .hero-solevia__overlay {
      background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.6) 100%);
    }
    .hero-solevia__content {
      display: flex;
      align-items: flex-end;
      min-height: 420px;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "default": "Walk on clouds.", "label": "Heading" },
    { "type": "text", "id": "subheading", "default": "Give your feet the comfort they deserve: support, relief, and a gentle massage with every step.", "label": "Subheading" },
    { "type": "text", "id": "button_label", "default": "Shop now & save up to 70%", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_rating", "default": true, "label": "Show rating" },
    { "type": "text", "id": "rating_score", "default": "4.8/5.0", "label": "Rating score" },
    { "type": "text", "id": "rating_count", "default": "rated by 10,000+ reviews", "label": "Rating text" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
